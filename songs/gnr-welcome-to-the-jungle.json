   "time": 300,
   "feedback": 15,
   "level": 20
  },
  "reverb": {
   "type": "ROOM",
   "on": true,
   "time": 20,
   "level": 18
  },
  "noise_suppressor": {
   "on": true,
   "threshold": 15
  }
 }
